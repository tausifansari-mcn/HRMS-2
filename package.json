{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks && echo hooks installed",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "schema-audit:build": "tsc -p tools/schema-auditor/tsconfig.json",
    "schema-audit:check": "npm run schema-audit:build && node tools/schema-auditor/dist/cli.js check",
    "schema-audit:collect": "npm run schema-audit:build && node tools/schema-auditor/dist/cli.js collect",
    "schema-audit:analyze": "npm run schema-audit:build && node tools/schema-auditor/dist/cli.js analyze",
    "schema-audit:report": "npm run schema-audit:build && node tools/schema-auditor/dist/cli.js report",
    "schema-audit:run": "npm run schema-audit:build && node tools/schema-auditor/dist/cli.js run --no-data-profile",
    "schema-audit:test": "node ./backend/node_modules/vitest/vitest.mjs run --config tools/schema-auditor/vitest.config.ts",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:routes": "node backend/node_modules/vitest/vitest.mjs run scripts/app-route-composition.test.tsx --config vite.config.ts --globals",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:all": "npm run build && cd backend && npm run build",
    "phase2:smoke": "cd backend && npm run phase2:smoke:live:dangerous",
    "phase2:smoke:static": "node scripts/phase2-smoke-static.mjs",
    "health:backend": "node -e \"fetch('http://localhost:5055/api/health').then(r=>r.text()).then(console.log).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "test": "cd backend && npx vitest run",
    "test:frontend": "node backend/node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:all": "npm run test:frontend && npm run test",
    "test:e2e:smoke": "playwright test --config=playwright.config.ts",
    "lms:backfill-identities": "cd backend && npm.cmd run lms:backfill-identities"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
