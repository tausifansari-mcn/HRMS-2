    "react-apexcharts": "1.9.0",
    "react-confetti": "^6.4.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-image-crop": "^11.1.2",
    "react-leaflet": "^4.2.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "vaul": "^0.9.9",
    "vite-plugin-pwa": "^1.2.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^11.0.1",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.3.3",
    "mysql2": "^3.24.4",
    "postcss": "^8.5.28",
    "rolldown": "^1.2.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "@swc/core@1.15.33": true,
    "core-js@3.49.0": true,
    "esbuild@0.25.12": true
  }
}
